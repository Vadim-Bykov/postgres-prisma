generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Users {
  id                Int                 @id @unique @default(autoincrement())
  name              String
  email             String              @unique
  password          String
  role              Role                @default(USER)
  image             String?
  project           Project             @default(ASTRO)
  environment       Environment         @default(production)
  location          Location?
  Token             Token[]
  passwordResetLink PasswordResetLink[]

  purchase Purchase[]

  emailNotification  Boolean             @default(true)
  articleEmails      ArticleEmail[]
  consultationEmails ConsultationEmail[]

  wallet Wallet?
  Bonus  Bonus[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  lastVisitAt DateTime  @default(now())

  Consultation   Consultation? @relation(fields: [consultationId], references: [id])
  consultationId Int?

  invitedByFriendEmail String?
  I_am_Friend          Friend?  @relation("I_am_Friend")
  Friends              Friend[]
}

model Token {
  refreshToken String @id @unique
  userId       Int
  Users        Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  city         String?
  country      String?
  country_name String?
  userId       Int     @unique
  Users        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  link      String?
  state     PasswordResetLinkState @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime?
  userId    Int                    @unique
  Users     Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum Environment {
  production
  development
  preview
}

enum Project {
  IT_SCHOOL
  ASTRO
}

enum PasswordResetLinkState {
  PENDING
  REQUESTED
  USED
}

enum ConsultationStatus {
  PUBLISHED
  PENDING
  DEPRECATED
}

enum Currency {
  RUB @map("₽")
  USD @map("$")
  BYN @map("Br")
}

model Consultation {
  id                Int                 @id @unique @default(autoincrement())
  title             String
  subTitle          String?
  description       String[]
  price             Int
  currency          Currency            @default(RUB)
  perksTitle        String?
  perks             String[]
  status            ConsultationStatus  @default(PENDING)
  primary           Boolean?            @default(false)
  removedAt         DateTime?
  purchase          Purchase[]
  consultationEmail ConsultationEmail[]
  imageSource       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?
  usersGotEmail     Users[]
}

enum PaymentSystem {
  MIR
  VISA
  MASTERCARD
}

model Banking {
  id            Int           @id @unique @default(autoincrement())
  bankName      String
  currency      Currency      @default(BYN)
  number        String
  ownerName     String?
  paymentSystem PaymentSystem @default(VISA)
  purchase      Purchase[]
}

enum PaymentStatus {
  CHECKING
  CONFIRMED
}

enum PurchaseStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Purchase {
  id                    Int            @id @unique @default(autoincrement())
  userId                Int
  users                 Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationId        Int
  consultation          Consultation   @relation(fields: [consultationId], references: [id])
  bankRecipientId       Int
  banking               Banking        @relation(fields: [bankRecipientId], references: [id])
  paymentNumber         String?
  status                PurchaseStatus @default(NOT_STARTED)
  paymentStatus         PaymentStatus  @default(CHECKING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime?
  paymentConfirmationAt DateTime?
  orderFulfillmentAt    DateTime?
  Bonus                 Bonus[]
  paidByMoney           Int            @default(0)
  paidByBonus           Int?
}

model ArticleEmail {
  id            Int      @id @unique @default(autoincrement())
  title         String
  articleId     Int      @unique
  usersGotEmail Users[]
  createdAt     DateTime @default(now())
}

model ConsultationEmail {
  id             Int          @id @unique @default(autoincrement())
  title          String
  consultationId Int          @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  usersGotEmail  Users[]
  createdAt      DateTime     @default(now())
}

model Wallet {
  id     Int   @id @unique @default(autoincrement())
  userId Int   @unique
  users  Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  bonusAmount Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

enum BonusType {
  REGISTRATION
  REGISTRATION_WITH_REFERRAL_EMAIL
  FRIEND_S_PURCHASE
}

model Bonus {
  id     Int   @id @unique @default(autoincrement())
  userId Int
  users  Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          BonusType
  amount        Int?
  purchasePrice Int?
  purchaseId    Int?
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  friendId      Int?
  friend        Friend?   @relation(fields: [friendId], references: [id])

  viewed Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime?
}

model Friend {
  id     Int   @id @unique @default(autoincrement())
  userId Int   @unique
  users  Users @relation("I_am_Friend", fields: [userId], references: [id], onDelete: Cascade)

  invitedByFriendEmail String
  friend               Users  @relation(fields: [invitedByFriendEmail], references: [email], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime?
  Bonus     Bonus[]
}
