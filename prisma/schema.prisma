generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Users {
  id          Int         @id @unique @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  role        Role        @default(USER)
  image       String?
  createdAt   DateTime    @default(now())
  environment Environment @default(production)
  project     Project     @default(IT_SCHOOL)
  location    Location?
  Token       Token[]
  passwordResetLink PasswordResetLink[]
}

model Token {
  refreshToken String @id @unique
  userId       Int
  Users        Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  city         String?
  country      String?
  country_name String?
  userId       Int     @unique
  Users        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  link        String?
  state       PasswordResetLinkState  @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?
  userId      Int     @unique
  Users       Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationAstro {
  country      String?
  city         String?
  country_name String?
  userId       Int        @unique
  UsersAstro   UsersAstro @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenAstro {
  refreshToken String     @id @unique
  userId       Int
  UsersAstro   UsersAstro @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsersAstro {
  id            Int            @id @unique @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  image         String?
  createdAt     DateTime       @default(now())
  environment   Environment    @default(production)
  project       Project        @default(ASTRO)
  LocationAstro LocationAstro?
  TokenAstro    TokenAstro[]
}

enum Role {
  USER
  ADMIN
}

enum Environment {
  production
  development
  preview
}

enum Project {
  IT_SCHOOL
  ASTRO
}

enum PasswordResetLinkState {
  PENDING
  REQUESTED
  USED
}

enum ConsultationStatus {
  PUBLISHED
  PENDING
  DEPRECATED
}
enum Currency {
  RUB @map("₽")
  USD @map("$")
}

model Consultation {
  id            Int            @id @unique @default(autoincrement())
  title         String
  price         Int
  currency      Currency      @default(RUB) 
  perks         String[]
  status        ConsultationStatus @default(PENDING)
  primary       Boolean?      @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime?
  removedAt     DateTime?
}