generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Users {
  id          Int         @id @unique @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  role        Role        @default(USER)
  image       String?
  createdAt   DateTime    @default(now())
  environment Environment @default(production)
  project     Project     @default(IT_SCHOOL)
  location    Location?
  Token       Token[]
}

model Token {
  refreshToken String @id @unique
  userId       Int
  Users        Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  city         String?
  country      String?
  country_name String?
  userId       Int     @unique
  Users        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationAstro {
  country      String?
  city         String?
  country_name String?
  userId       Int        @unique
  UsersAstro   UsersAstro @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenAstro {
  refreshToken String     @id @unique
  userId       Int
  UsersAstro   UsersAstro @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsersAstro {
  id            Int            @id @unique @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  image         String?
  createdAt     DateTime       @default(now())
  environment   Environment    @default(production)
  project       Project        @default(ASTRO)
  LocationAstro LocationAstro?
  TokenAstro    TokenAstro[]
}

enum Role {
  USER
  ADMIN
}

enum Environment {
  production
  development
  preview
}

enum Project {
  IT_SCHOOL
  ASTRO
}
