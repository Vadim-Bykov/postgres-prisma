generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Users {
  id                   Int                 @id @unique @default(autoincrement())
  name                 String
  email                String              @unique
  password             String
  role                 Role                @default(USER)
  image                String?
  createdAt            DateTime            @default(now())
  environment          Environment         @default(production)
  project              Project             @default(ASTRO)
  updatedAt            DateTime?
  emailNotification    Boolean             @default(true)
  lastVisitAt          DateTime            @default(now())
  consultationId       Int?
  invitedByFriendEmail String?
  Bonus                Bonus[]
  Friends              Friend[]
  I_am_Friend          Friend?             @relation("I_am_Friend")
  location             Location?
  passwordResetLink    PasswordResetLink?
  purchase             Purchase[]
  Token                Token[]
  Consultation         Consultation?       @relation(fields: [consultationId], references: [id])
  wallet               Wallet?
  articleEmails        ArticleEmail[]      @relation("ArticleEmailToUsers")
  consultationEmails   ConsultationEmail[] @relation("ConsultationEmailToUsers")
}

model Token {
  refreshToken String @id @unique
  userId       Int
  Users        Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  city         String?
  country      String?
  country_name String?
  userId       Int     @unique
  Users        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  link      String?
  state     PasswordResetLinkState @default(PENDING)
  createdAt DateTime               @default(now())
  userId    Int                    @unique
  updatedAt DateTime?
  Users     Users                  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Consultation {
  id                Int                @id @unique @default(autoincrement())
  title             String
  subTitle          String?
  price             Int
  currency          Currency           @default(RUB)
  status            ConsultationStatus @default(PENDING)
  primary           Boolean?           @default(false)
  createdAt         DateTime           @default(now())
  removedAt         DateTime?
  updatedAt         DateTime?
  imageSource       String
  description       String[]
  perksTitle        String?
  perks             String[]
  consultationEmail ConsultationEmail?
  purchase          Purchase[]
  usersGotEmail     Users[]
}

model Banking {
  id            Int           @id @unique @default(autoincrement())
  bankName      String
  currency      Currency      @default(BYN)
  number        String
  ownerName     String?
  paymentSystem PaymentSystem @default(VISA)
  purchase      Purchase[]
}

model Purchase {
  id                    Int            @id @unique @default(autoincrement())
  userId                Int
  consultationId        Int
  bankRecipientId       Int
  paymentNumber         String?
  createdAt             DateTime       @default(now())
  paymentStatus         PaymentStatus  @default(CHECKING)
  status                PurchaseStatus @default(NOT_STARTED)
  updatedAt             DateTime?
  orderFulfillmentAt    DateTime?
  paymentConfirmationAt DateTime?
  paidByBonus           Int?
  paidByMoney           Int            @default(0)
  Bonus                 Bonus[]
  banking               Banking        @relation(fields: [bankRecipientId], references: [id])
  consultation          Consultation   @relation(fields: [consultationId], references: [id])
  users                 Users          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ArticleEmail {
  id            Int      @id @unique @default(autoincrement())
  articleId     Int      @unique
  createdAt     DateTime @default(now())
  title         String
  usersGotEmail Users[]  @relation("ArticleEmailToUsers")
}

model ConsultationEmail {
  id             Int          @id @unique @default(autoincrement())
  title          String
  consultationId Int          @unique
  createdAt      DateTime     @default(now())
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  usersGotEmail  Users[]      @relation("ConsultationEmailToUsers")
}

model Wallet {
  userId      Int       @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  bonusAmount Int?
  id          Int       @id @unique @default(autoincrement())
  users       Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bonus {
  id            Int       @id @unique @default(autoincrement())
  userId        Int
  type          BonusType
  amount        Int?
  purchasePrice Int?
  purchaseId    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?
  friendId      Int?
  viewed        Boolean   @default(false)
  confirmed     Boolean   @default(false)
  friend        Friend?   @relation(fields: [friendId], references: [id])
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  users         Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friend {
  id                   Int       @id @unique @default(autoincrement())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime?
  invitedByFriendEmail String
  userId               Int       @unique
  Bonus                Bonus[]
  friend               Users     @relation(fields: [invitedByFriendEmail], references: [email], onDelete: Cascade)
  users                Users     @relation("I_am_Friend", fields: [userId], references: [id], onDelete: Cascade)
}

model users {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String    @unique @db.VarChar(255)
  image     String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
}

enum Role {
  USER
  ADMIN
}

enum Environment {
  production
  development
  preview
}

enum Project {
  IT_SCHOOL
  ASTRO
}

enum PasswordResetLinkState {
  PENDING
  REQUESTED
  USED
}

enum ConsultationStatus {
  PUBLISHED
  PENDING
  DEPRECATED
}

enum Currency {
  RUB @map("₽")
  USD @map("$")
  BYN @map("Br")
}

enum PaymentSystem {
  MIR
  VISA
  MASTERCARD
}

enum PaymentStatus {
  CHECKING
  CONFIRMED
}

enum PurchaseStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum BonusType {
  REGISTRATION
  REGISTRATION_WITH_REFERRAL_EMAIL
  FRIEND_S_PURCHASE
}
