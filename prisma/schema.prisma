generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Users {
  id          Int         @id @unique @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  role        Role        @default(USER)
  image       String?
  emailNotification Boolean @default(true)
  project     Project     @default(ASTRO)
  environment Environment @default(production)
  location    Location?
  Token       Token[]
  passwordResetLink PasswordResetLink[]
  purchase    Purchase[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?

}

model Token {
  refreshToken String @id @unique
  userId       Int
  Users        Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  city         String?
  country      String?
  country_name String?
  userId       Int     @unique
  Users        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetLink {
  link        String?
  state       PasswordResetLinkState  @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?
  userId      Int     @unique
  Users       Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum Environment {
  production
  development
  preview
}

enum Project {
  IT_SCHOOL
  ASTRO
}

enum PasswordResetLinkState {
  PENDING
  REQUESTED
  USED
}

enum ConsultationStatus {
  PUBLISHED
  PENDING
  DEPRECATED
}
enum Currency {
  RUB @map("₽")
  USD @map("$")
  BYN  @map("Br")
}

model Consultation {
  id            Int            @id @unique @default(autoincrement())
  title         String
  description   String[]
  price         Int
  currency      Currency      @default(RUB) 
  perks         String[]
  status        ConsultationStatus @default(PENDING)
  primary       Boolean?      @default(false)
  removedAt     DateTime?
  purchase      Purchase[]
  imageSource   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime?
}

enum PaymentSystem {
  MIR
  VISA
  MASTERCARD
}

model Banking {
  id            Int            @id @unique @default(autoincrement())
  bankName      String
  currency      Currency      @default(BYN) 
  number        String
  ownerName     String?
  paymentSystem PaymentSystem @default(VISA)
  purchase      Purchase[]
}

enum PaymentStatus {
  CHECKING
  CONFIRMED
}

enum PurchaseStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

model Purchase {
  id                  Int             @id @unique @default(autoincrement())
  userId              Int
  users               Users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultationId      Int             
  consultation        Consultation    @relation(fields: [consultationId], references: [id])
  bankRecipientId     Int           
  banking             Banking         @relation(fields: [bankRecipientId], references: [id])
  paymentNumber       String?  
  status              PurchaseStatus  @default(NOT_STARTED)
  paymentStatus       PaymentStatus   @default(CHECKING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime?
}